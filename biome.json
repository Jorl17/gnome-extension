{
  "$schema": "https://biomejs.dev/schemas/2.5.4/schema.json",
  "files": {
    "includes": ["**", "!!**/dist", "!!**/build"]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "includes": ["**/*.ts", "**/*.js", "**/*.css"]
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" },
    "includes": ["**/*.ts", "**/*.js", "**/*.css"]
  },
  "javascript": { "globals": ["imports"] }
}
